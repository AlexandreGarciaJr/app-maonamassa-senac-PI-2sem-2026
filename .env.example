# Copie este arquivo para .env.local e preencha.

# true = usa os dados de exemplo (src/mocks), sem banco. false = usa o Supabase.
VITE_USE_MOCKS=true

# Supabase (Project Settings > API Keys no painel do Supabase).
# A chave publicável pode ficar no app: quem protege os dados são as regras de acesso do banco.
# Nunca coloque aqui a chave secreta (sb_secret_...).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
